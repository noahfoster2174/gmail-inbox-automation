<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gmail-inbox-zero</string>
    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/gmail_cleanup/scripts/run_inbox_zero.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/PATH/TO/gmail_cleanup/logs/inbox_zero_out.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/gmail_cleanup/logs/inbox_zero_err.log</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
